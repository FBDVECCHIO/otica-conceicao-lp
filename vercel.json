{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "^/hub/?$", "dest": "/hub.html" },
    { "src": "^/admin/?$", "dest": "/hub.html" },
    { "src": "^/forlife/admin/?$", "dest": "/forlife/admin.html" },
    { "src": "^/forlife/?$", "dest": "/forlife/index.html" },
    { "handle": "filesystem" },
    { "src": "^/(.*)$", "dest": "/forlife/index.html" }
  ]
}
