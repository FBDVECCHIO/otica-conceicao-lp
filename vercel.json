{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/admin", "destination": "/hub" },
    { "source": "/hub", "destination": "/hub" },
    { "source": "/forlife", "destination": "/forlife" },
    { "source": "/forlife/admin", "destination": "/forlife/admin" },
    { "source": "/forlife/:path*", "destination": "/forlife/:path*" },
    { "source": "/visaosimples", "destination": "/visaosimples" },
    { "source": "/visaosimples/:path*", "destination": "/visaosimples/:path*" },
    { "source": "/194", "destination": "/visaosimples" },
    { "source": "/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/:slug", "destination": "/forlife" }
  ]
}
